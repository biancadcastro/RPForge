; Shared by the real setup and the non-installing presentation preview.
WizardStyle=modern dark windows11 includetitlebar hidebevels
WizardBackColor=#121218
WizardImageBackColor=#121218
WizardSmallImageBackColor=#121218
WizardImageFile=
WizardSmallImageFile=
WizardSizePercent=115,115
DefaultDialogFontName=Segoe UI
DisableWelcomePage=no
LicenseFile={#PresentationDir}\terms-license.txt

[LangOptions]
DialogFontSize=10

[Messages]
WelcomeLabel1=Você cria.%nO RPForge acompanha.
WelcomeLabel2=Instale as ferramentas do RPForge para preparar seus recursos de GTA V e FiveM.%n%nAntes de instalar, você pode consultar os termos de uso, a licença, a privacidade e os avisos de terceiros neste assistente.
WizardLicense=Termos de uso e licença
LicenseLabel=Leia os termos e a licença antes de continuar.
LicenseLabel3=Para instalar o RPForge, é necessário aceitar os termos de uso e a licença abaixo.
LicenseAccepted=Li e aceito os termos de uso e a licença.
LicenseNotAccepted=Não aceito os termos de uso e a licença.
FinishedHeadingLabel=RPForge instalado.
FinishedLabel=Tudo pronto para começar.%n%nSeus arquivos permanecem no computador. Você pode abrir o RPForge pelo menu Iniciar e usar as ações rápidas pelo botão direito em uma pasta.

