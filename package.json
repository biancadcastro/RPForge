{
  "name": "rpf-to-fivem",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "RPF Forge: convert open GTA V vehicle archives into FiveM resources from the Windows 11 context menu",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "convert": "node src/cli.js",
    "installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Build-Installer.ps1",
    "menu:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File windows/Install-ContextMenu.ps1",
    "menu:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File windows/Uninstall-ContextMenu.ps1"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  }
}
