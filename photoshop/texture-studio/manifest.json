{
  "manifestVersion": 5,
  "id": "dev.rpforge.texturestudio",
  "name": "RPForge Texture Studio",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "26.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "texturestudio.panel",
      "label": {
        "default": "RPForge Texture Studio",
        "pt-BR": "RPForge Texture Studio"
      },
      "minimumSize": {
        "width": 280,
        "height": 420
      },
      "maximumSize": {
        "width": 2000,
        "height": 4000
      },
      "preferredDockedSize": {
        "width": 330,
        "height": 700
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 760
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ]
        }
      ]
    },
    {
      "type": "panel",
      "id": "texturestudio.preview",
      "label": {
        "default": "Texture Studio — Prévia 3D",
        "pt-BR": "Texture Studio — Prévia 3D"
      },
      "minimumSize": {
        "width": 240,
        "height": 220
      },
      "maximumSize": {
        "width": 7680,
        "height": 4320
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 420
      },
      "preferredFloatingSize": {
        "width": 960,
        "height": 720
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  }
}
