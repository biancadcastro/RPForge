{
  "manifestVersion": 5,
  "id": "dev.rpforge.texturestudio",
  "name": "RPForge Texture Studio",
  "version": "1.2.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "26.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "texturestudio.panel",
      "label": {
        "default": "RPForge Texture Studio",
        "pt-BR": "RPForge Texture Studio"
      },
      "minimumSize": {
        "width": 280,
        "height": 420
      },
      "maximumSize": {
        "width": 2000,
        "height": 4000
      },
      "preferredDockedSize": {
        "width": 330,
        "height": 700
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 760
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon_D.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ],
          "species": [
            "generic"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon_N.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ],
          "species": [
            "generic"
          ]
        }
      ]
    },
    {
      "type": "panel",
      "id": "texturestudio.preview",
      "label": {
        "default": "3D Preview",
        "pt-BR": "Prévia 3D",
        "de-DE": "3D-Vorschau",
        "fr-FR": "Aperçu 3D",
        "es-ES": "Vista previa 3D",
        "it-IT": "Anteprima 3D",
        "ja-JP": "3D プレビュー",
        "ko-KR": "3D 미리 보기",
        "zh-CN": "3D 预览",
        "ru-RU": "3D-просмотр",
        "uk-UA": "3D-перегляд",
        "pl-PL": "Podgląd 3D",
        "cs-CZ": "Náhled 3D",
        "tr-TR": "3B Önizleme",
        "nl-NL": "3D-voorvertoning",
        "sv-SE": "3D-förhandsvisning",
        "da-DK": "3D-visning",
        "fi-FI": "3D-esikatselu",
        "nb-NO": "3D-forhåndsvisning"
      },
      "minimumSize": {
        "width": 240,
        "height": 220
      },
      "maximumSize": {
        "width": 7680,
        "height": 4320
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 420
      },
      "preferredFloatingSize": {
        "width": 960,
        "height": 720
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon_D.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ],
          "species": [
            "generic"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon_N.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ],
          "species": [
            "generic"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/plugin-list.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "ipc": {
      "enablePluginCommunication": true
    }
  }
}
